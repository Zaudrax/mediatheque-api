# Copier ce fichier en .env puis renseigner les valeurs (ne jamais versionner .env).

# Port HTTP de l'API
PORT=3000

# Base PostgreSQL lancée par docker compose
POSTGRES_USER=mediatheque
POSTGRES_PASSWORD=
POSTGRES_DB=mediatheque
POSTGRES_PORT=5432

# Chaîne de connexion utilisée par Prisma (reprendre les valeurs ci-dessus)
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:PORT/BASE?schema=public
DATABASE_URL=

# Secrets de signature des jetons : deux valeurs différentes, 32 caractères minimum.
# Génération : openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Durées de vie (facultatif) : access token au format jose (15m maximum conseillé), refresh en jours
ACCESS_TOKEN_DUREE=15m
REFRESH_TOKEN_DUREE_JOURS=7

# Origines navigateur autorisées, séparées par des virgules (les autres reçoivent 403)
CORS_ORIGINS=http://localhost:5173

# Limitation de débit (facultatif, valeurs par défaut ci-dessous)
LIMITE_AUTH_MAX=10
LIMITE_AUTH_FENETRE_MS=900000
LIMITE_GENERALE_MAX=300
LIMITE_GENERALE_FENETRE_MS=60000

# Nombre de proxys inverses devant l'API (0 en accès direct)
TRUST_PROXY=0

# Durée (jours) d'un emprunt créé automatiquement au retour d'un ouvrage réservé
DUREE_EMPRUNT_JOURS=21

# Assistant : « bouchon » (sans clé, sans réseau) ou « openai »
IA_FOURNISSEUR=bouchon
# Obligatoire si IA_FOURNISSEUR=openai ; ne jamais la versionner
OPENAI_API_KEY=
OPENAI_MODELE=gpt-4.1-mini
IA_MAX_JETONS_SORTIE=400
LIMITE_ASSISTANT_MAX=10

# Port exposé par « docker compose --profile app up »
API_PORT=3000
