# Copier ce fichier en .env.test pour lancer `npm test` en local (ne jamais versionner .env.test).
# Les tests VIDENT la base : elle doit être distincte de la base de développement
# et son nom doit finir par _test (garde-fou dans test/aide.js).
# `npm test` applique d'abord les migrations sur cette base (et la crée si besoin).

NODE_ENV=test
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5432/mediatheque_test?schema=public

# Secrets propres aux tests, différents de ceux de développement : openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CORS_ORIGINS=http://localhost:5173

# Limite relevée pour que les nombreuses connexions des tests ne soient pas bloquées ;
# le test dédié à la limitation recrée une application avec la limite réelle de 10.
LIMITE_AUTH_MAX=1000
